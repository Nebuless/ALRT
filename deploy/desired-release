#!/usr/bin/env python3
"""Choose the newest main push with a successful gated build and retained artifact."""
import json
import os
import subprocess

def api(path):
    return json.loads(subprocess.check_output(['gh','api','repos/'+os.environ['GITHUB_REPOSITORY']+'/'+path],text=True))
for run in api('actions/workflows/deploy.yml/runs?branch=main&event=push&per_page=30')['workflow_runs']:
    jobs = api('actions/runs/'+str(run['id'])+'/jobs?per_page=100')['jobs']
    artifacts = api('actions/runs/'+str(run['id'])+'/artifacts')['artifacts']
    if any(job['name']=='build' and job['conclusion']=='success' for job in jobs) and any(item['name']=='nebuless-release' and not item['expired'] for item in artifacts):
        print('run_id='+str(run['id']))
        print('version='+run['head_sha'])
        break
