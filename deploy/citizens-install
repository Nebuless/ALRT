#!/usr/bin/env python3
"""Prepare explicitly approved per-user Citizens service and Pi extension enrollment."""
import argparse
import json
import os
from pathlib import Path
import shlex
import stat
import sys


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--base', required=True)
    parser.add_argument('--state', required=True)
    parser.add_argument('--socket', required=True)
    parser.add_argument('--agent-dir', action='append', default=[])
    parser.add_argument('--collector-uid', type=int, default=os.getuid())
    parser.add_argument('--pi-dir')
    parser.add_argument('--python', default=sys.executable)
    args = parser.parse_args()
    base = Path(args.base)
    release = (base / 'current').resolve()
    for value in [base, Path(args.state), Path(args.socket), Path(args.python)]:
        if not value.is_absolute() or any(character in str(value) for character in '\n\r'):
            raise ValueError('absolute_paths_required')
    if not (release / 'deploy/citizens.py').is_file() or not (release / 'deploy/citizens-pi.mjs').is_file():
        raise ValueError('citizens_release_required')
    state = Path(args.state)
    state.mkdir(parents=True, mode=0o700, exist_ok=True)
    info = state.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise PermissionError('private_state_required')
    command = [args.python, str(base / 'current/deploy/citizens.py'), '--socket', args.socket, '--state', args.state, '--collector-uid', str(args.collector_uid)]
    for directory in args.agent_dir:
        if not Path(directory).is_absolute():
            raise ValueError('absolute_agent_root_required')
        command += ['--agent-dir', directory]
    if args.pi_dir:
        directory = Path(args.pi_dir)
        if not directory.is_absolute():
            raise ValueError('absolute_pi_root_required')
        extensions = directory / 'extensions'
        extensions.mkdir(mode=0o700, parents=True, exist_ok=True)
        # The discovered extension gets its fixed socket from this user-private module.
        config = extensions / 'nebuless-citizens-config.mjs'
        local = Path.home() / '.local/share/nebuless-citizens/extension.json'
        local.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        local.write_text(json.dumps({'socket': args.socket, 'module': str(base / 'current/deploy/citizens-pi.mjs')})+'\n')
        local.chmod(0o600)
        body = '''import { readFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';
export default async function citizens(pi) {
    const config = JSON.parse(readFileSync(join(homedir(), '.local/share/nebuless-citizens/extension.json'), 'utf8'));
    process.env.NEBULESS_CITIZENS_SOCKET = config.socket;
    const extension = await import(pathToFileURL(config.module).href);
    return extension.default(pi);
}
'''
        if config.exists() and config.read_text() != body:
            raise ValueError('existing_extension_config_conflict')
        config.write_text(body)
        os.chmod(config, 0o600)
    unit = '[Unit]\nDescription=Nebuless Citizens private agent bridge\n\n[Service]\nType=simple\nExecStart='+shlex.join(command)+'\nRestart=on-failure\nUMask=0077\nNoNewPrivileges=true\n\n[Install]\nWantedBy=default.target\n'
    output = state / 'nebuless-citizens.service'
    output.write_text(unit)
    os.chmod(output, 0o600)
    print(json.dumps({'prepared': True, 'service_definition': str(output), 'pi_extension_enrolled': args.pi_dir is not None, 'services_started': False}))


if __name__ == '__main__':
    main()
