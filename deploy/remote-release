#!/usr/bin/env python3
"""Deploy through a dedicated pinned SSH identity. Never enroll or replace host policy."""
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import tempfile
import tarfile
import json
from deployment import sha256_file

archive = Path(sys.argv[1]).resolve()
target, base = os.environ['DEPLOY_TARGET'], os.environ['DEPLOY_BASE']
version = os.environ['EXPECTED_VERSION']
if not re.fullmatch(r'[a-f0-9]{40}',version) or not re.fullmatch(r'[A-Za-z0-9_.-]+@[A-Za-z0-9_.-]+',target) or not re.fullmatch(r'/[A-Za-z0-9_./-]+',base): raise SystemExit('Invalid deployment inventory')
with tarfile.open(archive, 'r:gz') as tar:
    if json.load(tar.extractfile('release.json'))['version'] != version: raise SystemExit('Artifact version mismatch')
with tempfile.TemporaryDirectory(prefix='nebuless-deploy-') as temp:
    key = Path(temp)/'key'; key.write_text(os.environ.pop('DEPLOY_SSH_KEY')); key.chmod(0o600)
    known = Path(temp)/'known_hosts'; known.write_text(os.environ['DEPLOY_HOST_KEY']+'\n'); known.chmod(0o600)
    options = ['-i',str(key),'-o','IdentitiesOnly=yes','-o','BatchMode=yes','-o','StrictHostKeyChecking=yes','-o','UserKnownHostsFile='+str(known),'-o','ConnectTimeout=10']
    remote = base+'/incoming-'+version+'.tar.gz'
    # No scp remote shell expansion: write to a fixed installation-owned path.
    with archive.open('rb') as data:
        subprocess.run(['ssh',*options,target,shlex.join(['sh','-c','umask 077; cat > '+shlex.quote(remote)])],stdin=data,check=True)
    digest = sha256_file(archive)
    # The installed runner may predate release safeguards. Authenticate the exact
    # archive and its bootstrap member before executing candidate release code.
    bootstrap = r"""
import hashlib,json,os,subprocess,sys,tarfile,tempfile
from pathlib import Path
base,archive,digest,version = sys.argv[1:]
archive = Path(archive)
hash = hashlib.sha256()
with archive.open('rb') as source:
    while chunk := source.read(1024*1024): hash.update(chunk)
if hash.hexdigest() != digest: raise SystemExit('Release archive verification failed')
with tarfile.open(archive,'r:gz') as tar:
    manifests = [member for member in tar.getmembers() if member.name == 'release.json']
    runners = [member for member in tar.getmembers() if member.name == 'deploy/deployment.py']
    if len(manifests) != 1 or len(runners) != 1 or not manifests[0].isfile() or not runners[0].isfile(): raise SystemExit('Release bootstrap missing')
    manifest = json.load(tar.extractfile(manifests[0]))
    runner = tar.extractfile(runners[0]).read()
    if manifest['version'] != version or hashlib.sha256(runner).hexdigest() != manifest['files']['deploy/deployment.py']: raise SystemExit('Release bootstrap verification failed')
os.umask(0o077)
with tempfile.TemporaryDirectory(prefix='.bootstrap-',dir=base) as directory:
    path = Path(directory)/'deployment.py'
    path.write_bytes(runner)
    subprocess.run([sys.executable,str(path),'release',base,str(archive)],check=True)
archive.unlink()
"""
    command = shlex.join(['python3','-c',bootstrap,base,remote,digest,version])
    subprocess.run(['ssh',*options,target,command],check=True)
